<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypelocation="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>coco_user_{{NAME}}</name>
  <version>0.1.0</version>
  <description>{{KIND_TITLE}} "{{NAME}}" written against coco_lab.api, as a ROS 2 node in COCO's Nav2 (generated by COCO Lab R2).</description>
  <maintainer email="noreply@example.invalid">{{AUTHOR}}</maintainer>
  <license>{{LICENCE}}</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>coco_lab</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_common</exec_depend>
  <exec_depend>gazebo_models</exec_depend>
  <exec_depend>custom_teleop</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
