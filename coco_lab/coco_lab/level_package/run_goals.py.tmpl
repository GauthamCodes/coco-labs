"""
@@PKG@@: drive the scenario's goals in order through Nav2's NavigateToPose, and write what happened.

    ros2 run @@PKG@@ run_goals [--out results.json] [--timeout 300]

Each goal: Nav2's result (SUCCEEDED / ABORTED / CANCELED, or a timeout), the sim time it took, and
the distance from AMCL's last pose (/amcl_pose) to the goal. A STACK run (COCO's ROS 2 stack in
Gazebo, a simulation; never hardware). Exit 0 only if every goal SUCCEEDED. Generated by COCO Lab
(coco_lab.level_package) for level @@LEVEL_ID@@, scenario @@SCENARIO@@.
"""
import argparse
import json
import math
import os
import sys
import time

from ament_index_python.packages import get_package_share_directory
from geometry_msgs.msg import PoseWithCovarianceStamped
from lifecycle_msgs.srv import GetState
from nav2_msgs.action import NavigateToPose
import rclpy
from rclpy.action import ActionClient
from rclpy.node import Node
from rclpy.parameter import Parameter
from rclpy.qos import DurabilityPolicy, QoSProfile

STATUS = {4: 'SUCCEEDED', 5: 'CANCELED', 6: 'ABORTED'}


class Goals(Node):
    def __init__(self):
        super().__init__('@@PKG@@_goals', parameter_overrides=[
            Parameter('use_sim_time', Parameter.Type.BOOL, True)])
        self.client = ActionClient(self, NavigateToPose, 'navigate_to_pose')
        self.pose = None
        self.create_subscription(PoseWithCovarianceStamped, '/amcl_pose', self.on_pose,
                                 QoSProfile(depth=1, durability=DurabilityPolicy.TRANSIENT_LOCAL))

    def on_pose(self, m):
        self.pose = (m.pose.pose.position.x, m.pose.pose.position.y)

    def nav2_active(self, timeout_s):
        """bt_navigator ACTIVE (lifecycle): before that its action server exists but rejects goals."""
        cli = self.create_client(GetState, '/bt_navigator/get_state')
        t0 = time.monotonic()
        while time.monotonic() - t0 < timeout_s:
            if cli.wait_for_service(timeout_sec=1.0):
                fut = cli.call_async(GetState.Request())
                if self.spin_until(fut, 5.0) and fut.result() is not None and fut.result().current_state.label == 'active':
                    return True
            rclpy.spin_once(self, timeout_sec=0.5)
        return False

    def sim_s(self):
        return self.get_clock().now().nanoseconds / 1e9

    def spin_until(self, fut, timeout_s):
        t0 = time.monotonic()
        while rclpy.ok() and not fut.done() and time.monotonic() - t0 < timeout_s:
            rclpy.spin_once(self, timeout_sec=0.1)
        return fut.done()


def main(argv=None):
    ap = argparse.ArgumentParser(prog='run_goals')
    ap.add_argument('--out', default='@@LEVEL_ID@@_@@SCENARIO@@_results.json')
    ap.add_argument('--timeout', type=float, default=300.0, help='seconds of wall time per goal')
    a = ap.parse_args(argv if argv is not None else [x for x in sys.argv[1:] if not x.startswith('--ros-args')])
    with open(os.path.join(get_package_share_directory('@@PKG@@'), 'scenario.json'), encoding='utf-8') as f:
        scenario = json.load(f)
    rclpy.init()
    node = Goals()
    if not node.client.wait_for_server(timeout_sec=300.0):
        print('[run_goals] no navigate_to_pose server in 300 s: is Nav2 up?', flush=True)
        return 2
    if not node.nav2_active(300.0):
        print('[run_goals] bt_navigator not active in 300 s: Nav2 did not finish starting', flush=True)
        return 2
    t0 = time.monotonic()
    while node.pose is None and time.monotonic() - t0 < 120.0:
        rclpy.spin_once(node, timeout_sec=0.2)
    print(f'[run_goals] Nav2 active; AMCL at {node.pose}', flush=True)
    results = []
    for g in scenario['goals']:
        msg = NavigateToPose.Goal()
        msg.pose.header.frame_id = 'map'
        msg.pose.header.stamp = node.get_clock().now().to_msg()
        msg.pose.pose.position.x, msg.pose.pose.position.y = float(g['goal'][0]), float(g['goal'][1])
        msg.pose.pose.orientation.w = 1.0
        t0 = node.sim_s()
        send = node.client.send_goal_async(msg)
        node.spin_until(send, 30.0)
        handle = send.result() if send.done() else None
        if handle is None or not handle.accepted:
            status = 'REJECTED'
        else:
            res = handle.get_result_async()
            status = STATUS.get(res.result().status, str(res.result().status)) if node.spin_until(res, a.timeout) else 'TIMEOUT'
            if status == 'TIMEOUT':
                cancel = handle.cancel_goal_async()
                node.spin_until(cancel, 10.0)
        for _ in range(10):
            rclpy.spin_once(node, timeout_sec=0.1)
        d = math.hypot(node.pose[0] - g['goal'][0], node.pose[1] - g['goal'][1]) if node.pose else None
        r = {'id': g['id'], 'goal': g['goal'], 'status': status, 'sim_s': round(node.sim_s() - t0, 2),
             'amcl_to_goal_m': None if d is None else round(d, 3)}
        results.append(r)
        print(f'[run_goals] {g["id"]}: {status} in {r["sim_s"]} s (sim), AMCL {r["amcl_to_goal_m"]} m from the goal', flush=True)
    doc = {'schema': 'coco_lab.level_package.results', 'version': 1, 'package': '@@PKG@@', 'level': '@@LEVEL_ID@@',
           'scenario': '@@SCENARIO@@', 'evidence_class': 'STACK (COCO\'s ROS 2 stack in Gazebo: a simulation, never hardware)',
           'utc': time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime()), 'results': results,
           'succeeded': sum(r['status'] == 'SUCCEEDED' for r in results), 'goals': len(results)}
    with open(a.out, 'w', encoding='utf-8') as f:
        json.dump(doc, f, indent=1)
        f.write('\n')
    print(f'[run_goals] {doc["succeeded"]}/{doc["goals"]} goals SUCCEEDED; written to {a.out}', flush=True)
    node.destroy_node()
    rclpy.shutdown()
    return 0 if doc['succeeded'] == doc['goals'] else 1


if __name__ == '__main__':
    sys.exit(main())
