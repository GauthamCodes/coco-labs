<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>@@PKG@@</name>
  <version>0.1.0</version>
  <description>COCO Lab level @@LEVEL_ID@@ (@@TITLE@@) and scenario @@SCENARIO@@, as a ROS 2 Jazzy package: Gazebo world, Nav2 map and parameters, goals. Generated by COCO Lab (coco_lab.level_package) from the World Spec; a simulation, never hardware.</description>
  <maintainer email="noreply@example.com">@@AUTHOR@@</maintainer>
  <license>Apache-2.0</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>lifecycle_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <!-- COCO's own robot packages (COCO Lab's repository; in the coco-ros2 image): the robot, its
       Gazebo and Nav2 bring-up, and cmd_vel_arbiter, the only wheel publisher -->
  <exec_depend>gazebo_models</exec_depend>
  <exec_depend>custom_teleop</exec_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
