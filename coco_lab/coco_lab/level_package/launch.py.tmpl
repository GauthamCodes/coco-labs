"""
COCO Lab level @@LEVEL_ID@@ (@@TITLE@@) in ROS 2 Jazzy: Gazebo with the level's world, then (once the
robot is at the start and its odometry calibrated: `bringup`) COCO's cmd_vel_arbiter and Nav2 with
the level's map and parameters -- the same bring-up as COCO's coco-ros2 image.

    ros2 launch @@PKG@@ level.launch.py [gui:=false] [user_package:=coco_user_<name>]

user_package: a package exported from COCO Lab's Studio ("Export as ROS 2 package"); its launch
file replaces Nav2's (it starts Nav2 with its own node in place of one component), given this
level's map and parameters. Empty (the default): stock Nav2. Generated by coco_lab.level_package.
"""
import json
import os

from ament_index_python.packages import get_package_share_directory
from launch import LaunchDescription
from launch.actions import DeclareLaunchArgument, IncludeLaunchDescription, OpaqueFunction, RegisterEventHandler
from launch.event_handlers import OnProcessExit
from launch.launch_description_sources import PythonLaunchDescriptionSource
from launch.substitutions import LaunchConfiguration
from launch_ros.actions import Node

PKG = '@@PKG@@'
LEVEL_ID = '@@LEVEL_ID@@'


def stack(context):
    share = get_package_share_directory(PKG)
    gz = get_package_share_directory('gazebo_models')
    teleop = get_package_share_directory('custom_teleop')
    level = os.path.join(share, 'level')
    world = os.path.join(level, 'gazebo', f'{LEVEL_ID}.sdf')
    mapf = os.path.join(level, 'nav2', f'{LEVEL_ID}.yaml')
    params = os.path.join(level, 'nav2', 'nav2_params.yaml')
    gui = LaunchConfiguration('gui').perform(context)
    user = LaunchConfiguration('user_package').perform(context).strip()
    sim = IncludeLaunchDescription(
        PythonLaunchDescriptionSource(os.path.join(gz, 'launch', 'full_world_robo.launch.py')),
        launch_arguments={'gui': gui, 'world': world}.items())
    bringup = Node(package=PKG, executable='bringup', name='level_bringup', output='screen')
    arbiter = IncludeLaunchDescription(
        PythonLaunchDescriptionSource(os.path.join(teleop, 'launch', 'arbiter.launch.py')),
        launch_arguments={'initial_mode': 'nav', 'use_sim_time': 'true'}.items())
    if user:
        # a Studio export's launch file reads COCO's start from COCO_INITIAL_POSE as it is loaded (a
        # localiser starts there; tools/r2/ros2_session.sh sets the same variable): this level's start
        with open(os.path.join(share, 'scenario.json'), encoding='utf-8') as f:
            os.environ['COCO_INITIAL_POSE'] = ','.join(str(v) for v in json.load(f)['start'])
        nav_file = os.path.join(get_package_share_directory(user), 'launch', f'{user}.launch.py')
        nav_args = {'use_sim_time': 'true', 'map': mapf, 'params_file': params}
    else:
        nav_file = os.path.join(gz, 'launch', 'nav.launch.py')
        nav_args = {'arbiter': 'true', 'use_sim_time': 'true', 'map': mapf, 'params_file': params}
    nav = IncludeLaunchDescription(PythonLaunchDescriptionSource(nav_file), launch_arguments=nav_args.items())

    def after(event, _context):
        if event.returncode != 0:
            print(f'[{PKG}] bring-up failed (exit {event.returncode}): the arbiter and Nav2 are not started', flush=True)
            return []
        return [arbiter, nav]
    return [sim, bringup, RegisterEventHandler(OnProcessExit(target_action=bringup, on_exit=after))]


def generate_launch_description():
    return LaunchDescription([
        DeclareLaunchArgument('gui', default_value='false', description='Gazebo client window (true/false)'),
        DeclareLaunchArgument('user_package', default_value='', description='a COCO Lab Studio export (coco_user_<name>), or empty for stock Nav2'),
        OpaqueFunction(function=stack),
    ])
