"""
@@PKG@@ bring-up: what COCO's coco-ros2 image does between the simulator and Nav2
(docker/coco-ros2/entrypoint.sh, the same commands): wait for /scan, put COCO at the level's
start (Gazebo's set_pose), and re-spawn diff_drive_controller with the level's odometry calibration
(derivation 5), checked. Exits non-zero, saying why, if any step fails: the launch file starts the
arbiter and Nav2 only after this succeeds. Generated by COCO Lab (coco_lab.level_package).
"""
import math
import os
import subprocess
import sys
import time

from ament_index_python.packages import get_package_share_directory

LEVEL_ID = '@@LEVEL_ID@@'
START = (@@START_X@@, @@START_Y@@, @@START_THETA@@)
TELEPORT = @@TELEPORT@@
MULTIPLIER = @@MULTIPLIER@@


def say(msg):
    print(f'[@@PKG@@] {msg}', flush=True)


def run(cmd, timeout):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return r.returncode, (r.stdout + r.stderr)
    except subprocess.TimeoutExpired:
        return 124, f'timed out after {timeout} s'


def main():
    share = get_package_share_directory('@@PKG@@')
    t0 = time.time()
    while True:
        rc, _ = run(['ros2', 'topic', 'echo', '/scan', '--once', '--field', 'header.stamp.sec'], 15)
        if rc == 0:
            say(f'the simulator publishes /scan after {time.time() - t0:.0f} s')
            break
        if time.time() - t0 > 300:
            say('FAILED: no /scan from the simulator in 300 s')
            return 2
    if TELEPORT:
        qz, qw = math.sin(START[2] / 2), math.cos(START[2] / 2)
        req = (f"name: 'coco', position: {{x: {START[0]}, y: {START[1]}, z: 0.05}}, "
               f'orientation: {{x: 0, y: 0, z: {qz}, w: {qw}}}')
        rc, out = run(['gz', 'service', '-s', f'/world/{LEVEL_ID}/set_pose', '--reqtype', 'gz.msgs.Pose',
                       '--reptype', 'gz.msgs.Boolean', '--timeout', '5000', '--req', req], 20)
        say(f'COCO to the start {START}: gz answered {out.strip()[:80]!r}')
        if rc != 0 or 'true' not in out:
            say('FAILED: the teleport to the start')
            return 3
        time.sleep(3)
    if MULTIPLIER is not None:
        cal = os.path.join(share, 'level', 'gazebo', 'diff_drive_calibration.yaml')
        for cmd, t in ((['ros2', 'control', 'set_controller_state', 'diff_drive_controller', 'inactive'], 30),
                       (['ros2', 'control', 'unload_controller', 'diff_drive_controller'], 30),
                       (['ros2', 'run', 'controller_manager', 'spawner', 'diff_drive_controller',
                         '-c', '/controller_manager', '-p', cal], 90)):
            rc, out = run(cmd, t)
            if rc != 0:
                say(f'FAILED: {" ".join(cmd[:4])}: {out.strip()[-200:]}')
                return 4
        rc, out = run(['ros2', 'param', 'get', '/diff_drive_controller', 'wheel_separation_multiplier'], 15)
        got = out.strip().split()[-1] if out.strip() else ''
        try:
            ok = abs(float(got) - MULTIPLIER) < 1e-9
        except ValueError:
            ok = False
        if not ok:
            say(f'FAILED: wheel_separation_multiplier is {got!r}, not {MULTIPLIER}')
            return 5
        say(f'odometry calibration loaded: wheel_separation_multiplier {got}')
    say('bring-up done: the arbiter and Nav2 start now')
    return 0


if __name__ == '__main__':
    sys.exit(main())
