<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>coco_lab</name>
  <version>0.2.0</version>
  <description>
    The COCO Lab core: graph-search algorithms that emit versioned,
    columnar traces, with their theorems tested as properties. Pure
    Python with a standard-library-only runtime and NO rclpy, so the same
    code runs in CI, in the browser under Pyodide, and inside a ROS node.
  </description>
  <maintainer email="gauthamanil888@gmail.com">gautham</maintainer>
  <license>Apache-2.0</license>

  <!-- No exec_depend on purpose: the runtime is the Python standard
       library. test_stdlib_only.py enforces it and test_no_ros.py
       enforces that no ROS module is ever imported. -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>
  <!-- Test-only: the property tests and their oracle. Both keys were
       checked with `rosdep resolve` (Jazzy, Ubuntu 24.04) and resolve to
       apt python3-hypothesis 6.98.15 and python3-networkx 2.8.8, which
       are the versions requirements-test.txt pins for pip installs. -->
  <test_depend>python3-hypothesis</test_depend>
  <test_depend>python3-networkx</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
