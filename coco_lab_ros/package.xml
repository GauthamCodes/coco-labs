<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>coco_lab_ros</name>
  <version>0.1.0</version>
  <description>
    COCO Lab's hook into the real stack. A planner node that snapshots the
    global costmap, plans from the robot's AMCL belief with a coco_lab
    algorithm, writes the trace, and hands the path to controller_server's
    FollowPath action. It never publishes velocity: the path rides the
    existing command chain into cmd_vel_arbiter. Also the pure adapters
    (costmap to LabMap, world/cell, path metrics) the conformance
    experiment and the bag exporter share.
  </description>
  <maintainer email="gauthamanil888@gmail.com">gautham</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>coco_lab</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <!-- Only for lab_stack.launch.py, which composes the existing bringup.
       Nothing depends on coco_lab_ros, so the graph stays acyclic
       (CLAUDE.md rule 6). -->
  <exec_depend>gazebo_models</exec_depend>
  <exec_depend>custom_teleop</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>
  <!-- Only for lab_ekf.launch.py (Lab 2), observe-only; the mission never
       loads it (test_ekf_config.py). -->
  <exec_depend>robot_localization</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-hypothesis</test_depend>
  <test_depend>python3-networkx</test_depend>
  <test_depend>nav2_map_server</test_depend>
  <test_depend>nav2_planner</test_depend>
  <test_depend>nav2_lifecycle_manager</test_depend>
  <test_depend>tf2_ros</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
