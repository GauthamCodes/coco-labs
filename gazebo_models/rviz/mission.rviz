# Navigation view: actual Nav2 planner and DWB controller outputs.
Panels:
- Class: rviz_common/Displays
  Help Height: 0
  Name: Displays
  Property Tree Widget:
    Expanded:
    - /WORLD1
    - /NAVIGATION1
    - /ROBOT1
    - /SENSORS1
    - /MISSION1
    Splitter Ratio: 0.88
  Tree Height: 700
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz_common/Group
    Name: WORLD
    Enabled: true
    Displays:
    - Alpha: 0.15
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 70; 75; 85
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 24
      Reference Frame: <Fixed Frame>
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/Map
      Color Scheme: map
      Draw Behind: true
      Enabled: true
      Name: Map
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map
      Update Topic:
        Value: /map_updates
      Use Timestamp: false
      Value: true
  - Class: rviz_common/Group
    Name: NAVIGATION
    Enabled: true
    Displays:
    - Alpha: 0.25
      Class: rviz_default_plugins/Map
      Color Scheme: costmap
      Draw Behind: false
      Enabled: true
      Name: Global Costmap
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /global_costmap/costmap
      Update Topic:
        Value: /global_costmap/costmap_updates
      Use Timestamp: false
      Value: true
    - Alpha: 0.22
      Class: rviz_default_plugins/Map
      Color Scheme: costmap
      Draw Behind: false
      Enabled: true
      Name: Local Costmap
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /local_costmap/costmap
      Update Topic:
        Value: /local_costmap/costmap_updates
      Use Timestamp: false
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 40; 230; 90
      Enabled: true
      Head Diameter: 0
      Head Length: 0
      Length: 0.3
      Line Style: Billboards
      Line Width: 0.04
      Name: Global Planner Path
      Offset:
        X: 0
        Y: 0
        Z: 0.02
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0
      Shaft Length: 0
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /plan
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 255; 190; 40
      Enabled: true
      Head Diameter: 0
      Head Length: 0
      Length: 0.3
      Line Style: Billboards
      Line Width: 0.06
      Name: Local Controller Trajectory
      Offset:
        X: 0
        Y: 0
        Z: 0.04
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0
      Shaft Length: 0
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /local_plan
      Value: true
  - Class: rviz_common/Group
    Name: ROBOT
    Enabled: true
    Displays:
    - Alpha: 1
      Class: rviz_default_plugins/RobotModel
      Collision Enabled: false
      Description File: ''
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Enabled: true
      Name: RobotModel
      TF Prefix: ''
      Update Interval: 0
      Value: true
      Visual Enabled: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 0.25
      Name: TF
      Show Arrows: false
      Show Axes: true
      Show Names: false
      Update Interval: 0
      Value: true
    - Alpha: 1
      Axes Length: 0.3
      Axes Radius: 0.03
      Class: rviz_default_plugins/PoseWithCovariance
      Color: 40; 90; 220
      Covariance:
        Orientation:
          Alpha: 0.5
          Color: 255; 255; 127
          Color Style: Unique
          Frame: Local
          Offset: 1
          Scale: 1
          Value: false
        Position:
          Alpha: 0.25
          Color: 170; 120; 220
          Scale: 1
          Value: true
        Value: true
      Enabled: true
      Head Length: 0.16
      Head Radius: 0.09
      Name: AMCL Pose
      Shaft Length: 0.34
      Shaft Radius: 0.035
      Shape: Arrow
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /amcl_pose
      Value: true
    - Class: nav2_rviz_plugins/ParticleCloud
      Color: 0; 180; 255
      Enabled: false
      Max Arrow Length: 0.25
      Min Arrow Length: 0.02
      Name: Particle Cloud
      Shape: Arrow (Flat)
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /particle_cloud
      Value: false
    - Class: rviz_default_plugins/Polygon
      Name: Robot Footprint
      Enabled: true
      Value: true
      Color: 255; 230; 80
      Alpha: 1
      Topic:
        Value: /local_costmap/published_footprint
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
  - Class: rviz_common/Group
    Name: SENSORS
    Enabled: true
    Displays:
    - Alpha: 0.9
      Autocompute Intensity Bounds: true
      Class: rviz_default_plugins/LaserScan
      Color: 0; 150; 180
      Color Transformer: FlatColor
      Enabled: true
      Name: LaserScan
      Position Transformer: XYZ
      Size (m): 0.02
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /scan
      Value: true
  - Class: rviz_common/Group
    Name: MISSION
    Enabled: true
    Displays:
    - Alpha: 1
      Axes Length: 0.4
      Axes Radius: 0.04
      Class: rviz_default_plugins/Pose
      Color: 255; 60; 200
      Enabled: true
      Head Length: 0.22
      Head Radius: 0.13
      Name: Goal (from plan)
      Shaft Length: 0.55
      Shaft Radius: 0.05
      Shape: Arrow
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /mission/goal
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/PointStamped
      Color: 255; 40; 40
      Enabled: true
      History Length: 1
      Name: Perception Target
      Radius: 0.1
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /perception/target
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/PointStamped
      Color: 255; 220; 0
      Enabled: true
      History Length: 1
      Name: Approach Target
      Radius: 0.07
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /approach/target
      Value: true
  Enabled: true
  Global Options:
    Background Color: 26; 28; 33
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
  - Class: rviz_default_plugins/Interact
    Hide Inactive Objects: true
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/SetInitialPose
    Covariance x: 0.25
    Covariance y: 0.25
    Covariance yaw: 0.06853891909122467
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /initialpose
  - Class: rviz_default_plugins/SetGoal
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /goal_pose
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 29
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 6
        Y: 0
        Z: 0
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 1.45
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 4.712389
    Saved: null
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: true
  Width: 1600
  X: 60
  Y: 60
